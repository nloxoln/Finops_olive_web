# systemd 서비스 정의 — EC2 부팅/재배포 시 앱을 자동 실행/재시작
[Unit]
Description=OliveYoung Clone (Node.js/Express)
After=network.target

[Service]
Type=simple
User=ec2-user
WorkingDirectory=/home/ec2-user/app
ExecStart=/usr/bin/node src/server.js
Restart=always
RestartSec=3

# 환경변수 파일 (DB 접속정보 등). EC2 에 아래 경로로 미리 만들어 둡니다.
# 민감정보라 git 에 올리지 않고 서버에 직접 두거나 SSM 으로 관리하세요.
EnvironmentFile=/home/ec2-user/app.env

[Install]
WantedBy=multi-user.target
